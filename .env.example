# ==============================================================================
# Online Attendance Tracking System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local development or production environment.
# NEVER commit the real .env file or production credentials to version control.

# ------------------------------------------------------------------------------
# 1. Django Security & Core Settings
# ------------------------------------------------------------------------------
# In production, generate a cryptographically strong secret key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-cryptographically-strong-random-secret-key

# Set DEBUG=False in production! Never run production with DEBUG=True.
DEBUG=False

# Comma-separated list of fully qualified domain names and IP addresses
ALLOWED_HOSTS=attendance.yourinstitution.edu,127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF protection on HTTPS (Django 4.0+)
# Include protocol scheme (https://) and port if non-standard
CSRF_TRUSTED_ORIGINS=https://attendance.yourinstitution.edu

# ------------------------------------------------------------------------------
# 2. Production Database Configuration (PostgreSQL Recommended)
# ------------------------------------------------------------------------------
# For production high concurrency (simultaneous teacher submissions), use PostgreSQL.
# Option A: Standard 12-Factor DATABASE_URL (takes precedence if provided)
DATABASE_URL=postgresql://attendance_user:StrongDbPassword123!@localhost:5432/attendance_db

# Option B: Discrete database parameters (used if DATABASE_URL is not set)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=attendance_db
# DB_USER=attendance_user
# DB_PASSWORD=StrongDbPassword123!
# DB_HOST=localhost
# DB_PORT=5432

# Database Connection Pooling (seconds to keep connection open, default: 600)
CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. HTTPS, Reverse Proxy & Security Hardening (Active when DEBUG=False)
# ------------------------------------------------------------------------------
# Automatically redirect all non-HTTPS HTTP traffic to HTTPS (default: True in prod)
SECURE_SSL_REDIRECT=True

# Set to True if running behind a reverse proxy (Nginx, Caddy, AWS ALB, Cloudflare)
# that terminates SSL and passes the X-Forwarded-Proto header
USE_X_FORWARDED_PROTO=True

# HTTP Strict Transport Security (HSTS) - 31536000 seconds = 1 year
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# 4. Session & Cookie Security
# ------------------------------------------------------------------------------
# Default session lifetime in seconds (14 days = 1209600)
SESSION_COOKIE_AGE=1209600

# ------------------------------------------------------------------------------
# 5. Attendance Business Rules Configuration
# ------------------------------------------------------------------------------
# Maximum past calendar days a teacher can backdate attendance (default: 7)
MAX_BACKDATED_ATTENDANCE_DAYS=7

# ------------------------------------------------------------------------------
# 6. Production Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

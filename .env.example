# ==============================================================================
# Online Attendance Tracking System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local development or production environment.

# Django Security & Core Settings
SECRET_KEY=replace-with-a-random-secret-key-for-local-development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Attendance Business Rules
# Maximum past calendar days a teacher can backdate attendance (default: 7)
MAX_BACKDATED_ATTENDANCE_DAYS=7

# Session Security Configuration
# Default session duration in seconds (14 days = 1209600)
SESSION_COOKIE_AGE=1209600

# Production HTTPS & Security Settings (Only active when DEBUG=False)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
